<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <IncludeCompositeObjects>True</IncludeCompositeObjects>
    <TargetDatabaseName>CryptoVault</TargetDatabaseName>
    <DeployScriptFileName>CryptoVault.Database.sql</DeployScriptFileName>
    <TargetConnectionString>Data Source=your-sql-server-host.lan;Integrated Security=True;Persist Security Info=False;Pooling=False;MultipleActiveResultSets=False;Connect Timeout=60;Encrypt=True;TrustServerCertificate=True</TargetConnectionString>
    <ProfileVersionNumber>1</ProfileVersionNumber>
    <!-- Ensure database options declared in .sqlproj are applied to target -->
    <ScriptDatabaseOptions>True</ScriptDatabaseOptions>
    <BlockOnPossibleDataLoss>True</BlockOnPossibleDataLoss>
    <DeployDatabaseInSingleUserMode>False</DeployDatabaseInSingleUserMode>
    <DropObjectsNotInSource>False</DropObjectsNotInSource>
    <DoNotAlterReplicatedObjects>True</DoNotAlterReplicatedObjects>
  </PropertyGroup>
</Project>

