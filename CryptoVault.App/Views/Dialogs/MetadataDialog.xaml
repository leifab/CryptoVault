<Window x:Class="CryptoVault.MetadataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Metadata" Height="360" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock x:Name="ItemNameTextBlock" 
                   DockPanel.Dock="Top" 
                   FontWeight="SemiBold" 
                   FontSize="14" 
                   Margin="0,0,0,8" 
                   Text="Item Metadata" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Width="80" Height="26" Margin="0,0,8,0" IsDefault="True" Click="OnSaveClick" />
            <Button Content="Cancel" Width="80" Height="26" IsCancel="True" />
        </StackPanel>

        <DataGrid x:Name="MetadataGrid" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="True" 
                  CanUserDeleteRows="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="150" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>