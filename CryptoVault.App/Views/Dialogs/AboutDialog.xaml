<Window x:Class="CryptoVault.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About CryptoVault" 
        Height="190" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- App Icon -->
        <Image Grid.Row="0" Grid.Column="0" 
               Source="/Assets/cryptovault.ico" 
               Width="48" Height="48" 
               VerticalAlignment="Top" 
               Margin="0,2,16,0"/>

        <!-- App Information -->
        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Top">
            <TextBlock Text="CryptoVault" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <TextBlock Text="Version 0.1" FontSize="11" Margin="0,0,0,8" Opacity="0.7"/>
            <TextBlock Text="Secure File Repository &amp; Encryption Utility" Margin="0,0,0,4"/>
            <TextBlock Text="AES-256 GCM encrypted FileTable repository." FontSize="11" Opacity="0.7"/>
        </StackPanel>

        <!-- Bottom Button -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="75" Height="25" IsDefault="True" IsCancel="True" Click="OnOkClick"/>
        </StackPanel>
    </Grid>
</Window>

