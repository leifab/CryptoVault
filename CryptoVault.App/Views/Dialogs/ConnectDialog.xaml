<Window x:Class="CryptoVault.ConnectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect to Repository" 
        Height="250" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Server -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Server:" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox x:Name="ServerTextBox" Grid.Row="0" Grid.Column="1" Margin="0,4" Text=""/>

        <!-- Database -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Database:" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox x:Name="DatabaseTextBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Text=""/>

        <!-- Windows Authentication Checkbox -->
        <CheckBox x:Name="WindowsAuthCheckBox" 
                  Grid.Row="2" Grid.Column="1" 
                  Content="Use Windows Authentication" 
                  Margin="0,6,0,6" 
                  Checked="OnWindowsAuthCheckBoxToggle"
                  Unchecked="OnWindowsAuthCheckBoxToggle"/>

        <!-- Username -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="User ID:" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox x:Name="UsernameTextBox" Grid.Row="3" Grid.Column="1" Margin="0,4"/>

        <!-- Password -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="0,4"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="4" Grid.Column="1" Margin="0,4"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Connect" Width="75" Height="25" Margin="0,0,8,0" IsDefault="True" Click="OnConnectClick"/>
            <Button Content="Cancel" Width="75" Height="25" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>