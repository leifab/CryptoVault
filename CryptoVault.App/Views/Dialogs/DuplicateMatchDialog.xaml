<Window x:Class="CryptoVault.DuplicateMatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Matching Video Content Detected" 
        Height="380" Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <DockPanel Margin="14">
        <!-- Top Informational Header -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Potential duplicate or matching video content was detected for incoming file:" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,3" 
                       TextWrapping="Wrap" />
            <TextBlock x:Name="IncomingFileTextBlock" 
                       FontSize="13" 
                       FontWeight="Bold" 
                       Margin="0,0,0,6" 
                       TextTrimming="CharacterEllipsis" 
                       Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            <TextBlock Text="Top matching videos found in vault repository:" 
                       FontSize="11" 
                       Opacity="0.75" />
        </StackPanel>

        <!-- Bottom Action Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Skip File" 
                    Width="90" Height="26" 
                    Margin="0,0,10,0" 
                    IsCancel="True" 
                    FontWeight="SemiBold"
                    Click="OnSkipClick" />
            <Button Content="Import Anyway" 
                    Width="110" Height="26" 
                    Click="OnImportAnywayClick" />
        </StackPanel>

        <!-- Candidate Matches Grid -->
        <DataGrid x:Name="MatchesGrid" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False" 
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Matched File" Binding="{Binding DisplayName}" Width="*" />
                <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidencePercentage}" Width="90" FontWeight="Bold" />
                <DataGridTextColumn Header="Matched Frames" Binding="{Binding FrameMatchDisplay}" Width="115" />
                <DataGridTextColumn Header="Offset" Binding="{Binding FormattedOffset}" Width="90" />
                <DataGridTextColumn Header="Hash" Binding="{Binding FileId}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

