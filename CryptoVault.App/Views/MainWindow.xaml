<Window x:Class="CryptoVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="CryptoVault" Width="640" Height="480" 
        MinWidth="320" MinHeight="240"
        ResizeMode="CanResize"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop"
        Icon="/Assets/cryptovault.ico">
    <DockPanel>
        <!-- Top Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem x:Name="ConnectMenuItem" Header="_Connect to Repo..." Click="OnConnectRepoClick" />
                <MenuItem x:Name="DisconnectMenuItem" Header="_Disconnect" Click="OnDisconnectRepoClick" IsEnabled="False" />
                <Separator />
                <MenuItem Header="_Exit" Click="OnExitClick"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="OnAboutClick"/>
            </MenuItem>
        </Menu>

        <!-- Bottom Status Bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StatusBar}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock x:Name="StatusTextBlock" Grid.Column="0" Text="Disconnected" VerticalAlignment="Center" />
                    <ProgressBar x:Name="OperationProgressBar" 
                                 Grid.Column="1" 
                                 Width="150" 
                                 Height="14" 
                                 Margin="0,0,25,0" 
                                 Minimum="0" 
                                 Maximum="100" 
                                 Visibility="Collapsed" 
                                 VerticalAlignment="Center" />
                </Grid>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content Area -->
        <DockPanel Margin="10">
            <!-- Breadcrumb / Location Header -->
            <TextBlock x:Name="CurrentPathTextBlock" 
                       DockPanel.Dock="Top" 
                       Margin="0,0,0,6" 
                       FontWeight="SemiBold" 
                       Text="/" />

            <!-- Vault Browser List -->
            <ListView x:Name="VaultListView" 
                      MouseDoubleClick="OnVaultListViewMouseDoubleClick"
                      PreviewMouseLeftButtonDown="OnVaultListViewPreviewMouseLeftButtonDown"
                      GridViewColumnHeader.Click="OnGridViewColumnHeaderClick"
                      KeyDown="OnVaultListViewKeyDown"
                      SelectionMode="Extended"
                      SizeChanged="OnVaultListViewSizeChanged">
                <ListView.ContextMenu>
                    <ContextMenu Opened="OnContextMenuOpened">
                        <MenuItem x:Name="MetadataMenuItem" Header="Metadata..." Click="OnMetadataClick" />
                        <MenuItem x:Name="DecryptToMenuItem" Header="Decrypt to..." Click="OnDecryptToClick" />
                        <MenuItem x:Name="MoveToMenuItem" Header="_Move to..." Click="OnMoveToClick" />
                        <MenuItem x:Name="DeleteMenuItem" Header="_Delete" Click="OnDeleteClick" InputGestureText="Del" />
                        <Separator />
                        <MenuItem Header="New Folder..." Click="OnNewFolderClick" />
                        <MenuItem Header="Refresh" Click="OnRefreshClick" />
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn x:Name="TypeColumn" Header="Type" Width="70" DisplayMemberBinding="{Binding ItemType}" />
                        <GridViewColumn x:Name="NameColumn" Header="Name" DisplayMemberBinding="{Binding DisplayName}" />
                        <GridViewColumn x:Name="HashColumn" Header="Hash" Width="240" DisplayMemberBinding="{Binding FileHash}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </DockPanel>
</Window>
